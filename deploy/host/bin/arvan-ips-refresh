#!/usr/bin/env bash
# Regenerates /etc/nginx/conf.d/00-realip-arvan.conf from ArvanCloud's published
# edge ranges (https://www.arvancloud.ir/en/ips.txt) so nginx trusts
# X-Forwarded-For only from ArvanCloud. Weekly via arvan-ips.timer. Keeps the
# old file if the download looks wrong or nginx -t fails.
set -euo pipefail
URL="https://www.arvancloud.ir/en/ips.txt"
OUT=/etc/nginx/conf.d/00-realip-arvan.conf
tmp="$(mktemp)"; trap 'rm -f "$tmp" "$tmp.conf"' EXIT
curl -fsSL -m 30 "$URL" | tr -d '\r' > "$tmp"
cidr4='^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'; cidr6='^[0-9a-fA-F:]+/[0-9]{1,3}$'
n=0
{
  echo "# Generated by /opt/infra/bin/arvan-ips-refresh from $URL on $(date -u +%F). Do not edit."
  while read -r line; do
    [[ -z "$line" ]] && continue
    [[ "$line" =~ $cidr4 || "$line" =~ $cidr6 ]] || { echo "unexpected line: $line" >&2; exit 1; }
    echo "set_real_ip_from $line;"; n=$((n+1))
  done < "$tmp"
  echo "real_ip_header X-Forwarded-For;"
  echo "real_ip_recursive on;"
} > "$tmp.conf"
(( n >= 5 )) || { echo "only $n ranges downloaded; keeping the current file" >&2; exit 1; }
if [[ -f "$OUT" ]] && diff -q <(grep -v '^#' "$OUT") <(grep -v '^#' "$tmp.conf") >/dev/null; then
  echo "ArvanCloud ranges unchanged ($n)"; exit 0
fi
bak=/etc/nginx/00-realip-arvan.conf.previous
[[ -f "$OUT" ]] && cp "$OUT" "$bak"
install -m 644 "$tmp.conf" "$OUT"
if nginx -t -q; then systemctl reload nginx; echo "updated $OUT ($n ranges; previous copy: $bak)"
else
  echo "nginx -t failed; restoring the previous file" >&2
  if [[ -f "$bak" ]]; then cp "$bak" "$OUT"; else rm -f "$OUT"; fi; exit 1
fi
